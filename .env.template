# Copy to .env and provide your development credentials.
AVIATIONSTACK_API_KEY=
WEATHERSTACK_API_KEY=

# Seconds to wait for a provider response before failing the request.
PROVIDER_TIMEOUT=10

# When running with Docker Compose, the Redis hostname is "redis".
# For hosted Redis, set REDIS_URL (authenticated rediss://...) instead; it overrides host/port.
REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_EXPIRE=3600

# METAR observations (Aviation Weather Center); defaults shown.
METAR_USER_AGENT=ClearFlight-API/0.1 (+https://github.com/Yoyo-su/ClearFlight-API)
METAR_CACHE_TTL=600
METAR_NO_DATA_CACHE_TTL=300
METAR_RATE_LIMIT_PER_MINUTE=30
METAR_CURRENT_MAX_MINUTES=90
METAR_STALE_MAX_MINUTES=180
DEBUG=false
